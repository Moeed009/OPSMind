APP_NAME=OpsMind
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

APP_DATABASE_URL=postgresql+psycopg://opsmind_app.PROJECT_REF:APP_ROLE_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

REDIS_URL=redis://localhost:6379/0

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=SUPABASE_CV_BUCKET
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
FRONTEND_URL=http://localhost:5173

AUTH_ACCESS_COOKIE_NAME=opsmind_access_token
AUTH_REFRESH_COOKIE_NAME=opsmind_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Connectors (Phase 3)
CONNECTOR_ENCRYPTION_KEYS={"k1": "REPLACE_WITH_BASE64_32_BYTE_KEY"}
CONNECTOR_ENCRYPTION_CURRENT_KEY_ID=k1
OAUTH_STATE_SECRET=REPLACE_WITH_RANDOM_HEX_SECRET
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Google (Gmail, Drive, Calendar, Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Stripe
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=

# Composio Managed Integrations
COMPOSIO_API_KEY=

# AI Integration Layer
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1024
GROQ_RATE_LIMIT_RPM=30
GEMINI_RATE_LIMIT_RPM=15
AI_DEFAULT_PROVIDER=groq
AI_FAST_MODEL=gemini-2.5-flash
AI_PRO_MODEL=gemini-2.5-pro
AI_MAX_RETRIES=3
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0
AI_ALLOW_OFFLINE_FALLBACK=true
AI_DEFAULT_MONTHLY_BUDGET_USD=5.00
AI_CONFIDENCE_THRESHOLD=0.85

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=OpsMind Notifications
SMTP_USE_TLS=true
SMTP_USE_SSL=false
