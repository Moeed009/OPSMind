APP_NAME=OpsMind
ENVIRONMENT=development
DEBUG=false

# Both URLs point to the SAME Supabase PostgreSQL database.
# DATABASE_URL: Supabase postgres/admin connection, used only by Alembic migrations and DB tests that seed data.
# APP_DATABASE_URL: least-privilege opsmind_app role, used by the FastAPI application.
# Use Supabase Session Pooler (5432) or direct connection for DATABASE_URL.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Use Supabase Transaction Pooler (6543) for the application role.
APP_DATABASE_URL=postgresql+psycopg://opsmind_app.PROJECT_REF:APP_ROLE_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Redis remains a separate supporting service; it is not a database replacement.
REDIS_URL=redis://localhost:6379/0

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase Auth (use the project's anon/publishable key; NEVER use service_role here).
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
FRONTEND_URL=http://localhost:5173

# Browser auth cookies. Set AUTH_COOKIE_SECURE=true in HTTPS production.
AUTH_ACCESS_COOKIE_NAME=opsmind_access_token
AUTH_REFRESH_COOKIE_NAME=opsmind_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
